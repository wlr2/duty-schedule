# Copy this file to ".env.local" and fill in the two values from your Supabase
# project (Project Settings -> API). The app reads them automatically.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Needed later for push notifications (Step 6). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Needed later for AI scheduling explanations (optional). From console.anthropic.com
ANTHROPIC_API_KEY=
